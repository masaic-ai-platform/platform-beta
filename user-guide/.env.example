# OpenAI API Key for open-responses service
OPENAI_API_KEY=your_openai_api_key_here

# Spring profile for open-responses service
SPRING_PROFILES_ACTIVE=platform

# Dashboard API URL for platform-ui service
VITE_DASHBOARD_API_URL=http://localhost:6644

# Qdrant configuration
QDRANT_ALLOW_CREATION_ON_FILE_NOT_FOUND=true

# Open Responses Database Configuration
OPEN_RESPONSES_STORE_VECTOR_SEARCH_QDRANT_HOST=qdrant
OPEN_RESPONSES_MONGODB_URI=mongodb://mongo:27017
